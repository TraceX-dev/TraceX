{
  "name": "@hcengineering/pod-openauth",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "author": "TraceX",
  "template": "@hcengineering/node-package",
  "license": "EPL-2.0",
  "scripts": {
    "start": "rushx bundle && node bundle/bundle.js",
    "build": "compile",
    "build:watch": "compile",
    "_phase:bundle": "rushx bundle",
    "_phase:docker-build": "rushx docker:build",
    "_phase:docker-staging": "rushx docker:staging",
    "bundle": "node ../../common/scripts/esbuild.js --entry=src/__start.ts --keep-names=true --sourcemap=external --external=*.node",
    "docker:build": "../../common/scripts/docker_build.sh tracexapp/openauth",
    "docker:tbuild": "docker build -t tracexapp/openauth . --platform=linux/amd64 && ../../common/scripts/docker_tag_push.sh tracexapp/openauth",
    "docker:abuild": "docker build -t tracexapp/openauth . --platform=linux/arm64 && ../../common/scripts/docker_tag_push.sh tracexapp/openauth",
    "docker:staging": "../../common/scripts/docker_tag.sh tracexapp/openauth staging",
    "docker:push": "../../common/scripts/docker_tag.sh tracexapp/openauth",
    "run-local": "cross-env ACCOUNTS_URL=http://localhost:3000 PORT=3001 rushx start",
    "format": "format src",
    "test": "jest --passWithNoTests --silent --forceExit",
    "_phase:build": "compile transpile src",
    "_phase:test": "jest --passWithNoTests --silent --forceExit",
    "_phase:format": "format src",
    "_phase:validate": "compile validate"
  },
  "devDependencies": {
    "cross-env": "~7.0.3",
    "@hcengineering/platform-rig": "workspace:^0.7.21",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint": "^9.39.5",
    "esbuild": "^0.25.10",
    "@typescript-eslint/parser": "^8.67.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.15",
    "@types/jest": "^30.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-config-love": "^157.0.0"
  },
  "dependencies": {
    "@hcengineering/account-client": "workspace:^0.7.25",
    "@hcengineering/core": "workspace:^0.7.26",
    "@hcengineering/server-token": "workspace:^0.7.18",
    "@hono/node-server": "^2.1.5",
    "@openauthjs/openauth": "0.4.3",
    "arctic": "^2.3.4",
    "hono": "^4.13.13",
    "jose": "^5.10.0",
    "postgres": "^3.4.9"
  }
}
