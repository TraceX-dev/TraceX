{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copyright © 2026 TraceX SAS. Licensed under the Eclipse Public License, Version 2.0: https://www.eclipse.org/legal/epl-2.0 . Provided without warranties or conditions of any kind.",
  "title": "TraceX process authoring DSL v2",
  "description": "Authoring structure and expression syntax. The compiler additionally validates references, ordering, native model contracts and destination bindings. Extension properties remain supported.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 2
        },
        "kind": {
          "enum": [
            "card",
            "process"
          ]
        },
        "catalog": {
          "type": "object"
        },
        "processes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/process"
          }
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "documents": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/modelBlock"
            }
          }
        },
        "cardTypes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/modelBlock"
          }
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/modelBlock"
          }
        },
        "enums": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/modelBlock"
          }
        },
        "views": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/modelBlock"
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/modelBlock"
          }
        },
        "relations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/modelBlock"
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/modelBlock"
          }
        },
        "attributePermissions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/modelBlock"
          }
        },
        "sequences": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/modelBlock"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 2
        },
        "kind": {
          "enum": [
            "card",
            "process"
          ]
        },
        "catalog": {
          "type": "object"
        },
        "model": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "_id": {
                "type": "string",
                "minLength": 1
              },
              "_class": {
                "type": "string",
                "minLength": 1
              },
              "space": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true,
            "required": [
              "_id",
              "_class",
              "space"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "model"
      ]
    }
  ],
  "$defs": {
    "value": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    },
    "literal": {
      "type": "object",
      "properties": {
        "literal": {
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": false,
      "required": [
        "literal"
      ]
    },
    "class": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "ref"
          ]
        }
      ]
    },
    "type": {
      "oneOf": [
        {
          "enum": [
            "string",
            "number",
            "boolean",
            "date",
            "markup"
          ]
        },
        {
          "type": "object",
          "properties": {
            "array": {
              "$ref": "#/$defs/type"
            }
          },
          "additionalProperties": false,
          "required": [
            "array"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ref": {
              "$ref": "#/$defs/class"
            }
          },
          "additionalProperties": false,
          "required": [
            "ref"
          ]
        },
        {
          "type": "object",
          "properties": {
            "enum": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "enum"
          ]
        },
        {
          "type": "object",
          "properties": {
            "class": {
              "$ref": "#/$defs/class"
            },
            "label": {
              "type": "string"
            },
            "of": {
              "$ref": "#/$defs/value"
            },
            "to": {
              "$ref": "#/$defs/class"
            }
          },
          "additionalProperties": true,
          "required": [
            "class"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_class": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true,
          "required": [
            "_class"
          ]
        },
        {
          "type": "object",
          "properties": {
            "native": {
              "type": "object",
              "properties": {
                "_class": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true,
              "required": [
                "_class"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "native"
          ]
        }
      ]
    },
    "function": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/params"
          }
        }
      ]
    },
    "expression": {
      "description": "Source reduction happens before field selection; pipe transforms the selected value in order. Fallback is literal.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "from": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "$ref": "#/$defs/literal"
                }
              ]
            },
            "reduce": {
              "$ref": "#/$defs/function"
            },
            "pipe": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/function"
              }
            },
            "fallback": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false,
          "required": [
            "from"
          ]
        },
        {
          "type": "object",
          "properties": {
            "call": {
              "$ref": "#/$defs/function"
            },
            "reduce": {
              "$ref": "#/$defs/function"
            },
            "pipe": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/function"
              }
            },
            "fallback": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false,
          "required": [
            "call"
          ]
        }
      ]
    },
    "parameter": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        {
          "$ref": "#/$defs/literal"
        },
        {
          "type": "object",
          "properties": {
            "expr": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": false,
          "required": [
            "expr"
          ]
        },
        {
          "allOf": [
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/parameter"
              }
            },
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "expr"
                    ],
                    "maxProperties": 1
                  },
                  {
                    "required": [
                      "literal"
                    ],
                    "maxProperties": 1
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "output": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "class": {
              "$ref": "#/$defs/class"
            },
            "label": {
              "type": "string"
            },
            "order": {
              "type": "integer",
              "minimum": 0
            },
            "native": {
              "$ref": "#/$defs/value"
            }
          },
          "additionalProperties": false,
          "required": [
            "key"
          ]
        }
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/type"
        },
        "label": {
          "type": "string"
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "selectionSpace": {
          "$ref": "#/$defs/parameter"
        },
        "excludeRelation": {
          "$ref": "#/$defs/params"
        },
        "native": {
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "action": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "as": {
          "$ref": "#/$defs/output"
        },
        "context": {
          "type": [
            "object",
            "null"
          ]
        },
        "results": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/result"
              }
            },
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          ]
        },
        "native": {
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": true,
      "required": [
        "method"
      ]
    },
    "trigger": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/params"
          }
        }
      ]
    },
    "transition": {
      "type": "object",
      "properties": {
        "to": {
          "type": "string",
          "minLength": 1
        },
        "on": {
          "$ref": "#/$defs/trigger"
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/action"
          }
        },
        "native": {
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": true,
      "required": [
        "to",
        "on"
      ]
    },
    "state": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "transitions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/transition"
          }
        },
        "native": {
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": true
    },
    "slot": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "attribute",
            "class",
            "association",
            "process",
            "unknown"
          ]
        },
        "class": {
          "$ref": "#/$defs/class"
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "label": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "memberOf": {
          "type": "string"
        },
        "enumValues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "native": {
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": true,
      "required": [],
      "anyOf": [
        {
          "required": [
            "kind",
            "class"
          ]
        },
        {
          "required": [
            "type"
          ],
          "properties": {
            "kind": {
              "const": "attribute"
            }
          }
        }
      ]
    },
    "process": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "masterTag": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "autoStart": {
          "type": "boolean"
        },
        "parallelExecutionForbidden": {
          "type": "boolean"
        },
        "showInHeader": {
          "type": "boolean"
        },
        "automationOnly": {
          "type": "boolean"
        },
        "resultType": {
          "$ref": "#/$defs/type"
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/slot"
          }
        },
        "start": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/transition"
          }
        },
        "states": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/state"
          }
        },
        "context": {
          "type": "object"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "native": {
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": true,
      "required": [
        "label"
      ]
    },
    "modelBlock": {
      "type": "object"
    },
    "field": {
      "type": "object",
      "properties": {
        "attributeOf": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "required": {
          "type": "boolean"
        },
        "readonly": {
          "type": "boolean"
        },
        "automationOnly": {
          "type": "boolean"
        },
        "defaultValue": {
          "$ref": "#/$defs/value"
        },
        "native": {
          "$ref": "#/$defs/value"
        }
      },
      "additionalProperties": true
    }
  }
}
