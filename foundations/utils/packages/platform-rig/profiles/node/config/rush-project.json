{
  "incrementalBuildIgnoredGlobs": [
    "temp/**", 
    "lib/**", 
    "coverage/**",
    ".build/**",
    ".validate/**",
    ".format/**",
    "types"
  ],
  "disableBuildCacheForProject": false,

  "operationSettings": [
    {
      "operationName": "build",
      "outputFolderNames": ["lib", ".build"]
    },
    {
      "operationName": "test",
      "outputFolderNames": ["coverage"]
    },
    {
      "operationName": "format",
      "outputFolderNames": [".rush/temp/.format"]
    },
    {
      "operationName": "_phase:build",
      "outputFolderNames": ["lib", ".build"]
    },
    {
      "operationName": "_phase:validate",
      "dependsOnAdditionalFiles": [
        "node_modules/@hcengineering/platform-rig/native-validation.json",
        "node_modules/@hcengineering/platform-rig/bin/compile.js",
        "node_modules/@hcengineering/platform-rig/bin/native-validation.js"
      ],
      "outputFolderNames": ["types", ".validate"]
    },
    {
      "operationName": "_phase:bundle",
      "outputFolderNames": ["bundle"],
      "disableBuildCacheForOperation": true
    },
    {
      "operationName": "_phase:package",
      "outputFolderNames": ["dist"]
    },
    {
      "operationName": "_phase:test",
      "outputFolderNames": ["coverage"]
    }
  ]
}