{
  "name": "tracex-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "EPL-2.0",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.12.0 <25.0.0"
  },
  "scripts": {
    "build": "turbo run _phase:build",
    "validate": "turbo run _phase:validate",
    "test": "turbo run _phase:test --env-mode=loose",
    "svelte-check": "turbo run _phase:svelte-check",
    "typecheck:native": "npm exec --yes --package=typescript@7.0.2 -- tsc --noEmit -p dev/prod/tsconfig.native.json"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  },
  "pnpm": {
    "patchedDependencies": {
      "kafkajs@2.2.4": "common/pnpm-patches/kafkajs@2.2.4.patch"
    }
  }
}
